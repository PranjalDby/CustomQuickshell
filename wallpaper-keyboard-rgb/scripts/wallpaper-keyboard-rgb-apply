#!/usr/bin/env bash
set -euo pipefail

COLOR_FILE="${HOME}/.cache/wallpaper-keyboard-rgb/color"
STATE_FILE="${HOME}/.cache/wallpaper-keyboard-rgb/last-applied"
LOG_FILE="${HOME}/.cache/wallpaper-keyboard-rgb/sync.log"

mkdir -p "$(dirname "$STATE_FILE")"

log() {
    printf '[%s] %s\n' "$(date '+%F %T')" "$*" >> "$LOG_FILE"
}

if [[ ! -r "$COLOR_FILE" ]]; then
    log "Color file not found: $COLOR_FILE"
    exit 1
fi

COLOR="$(tr -d '[:space:]' < "$COLOR_FILE")"
COLOR="${COLOR#\#}"

if [[ ! "$COLOR" =~ ^[[:xdigit:]]{6}$ ]]; then
    log "Invalid Matugen color: '$COLOR'"
    exit 1
fi

COLOR="${COLOR,,}"

if [[ -r "$STATE_FILE" ]] && [[ "$(cat "$STATE_FILE")" == "$COLOR" ]]; then
    exit 0
fi

if ! command -v asusctl >/dev/null 2>&1; then
    log "asusctl is not installed or not in PATH"
    exit 1
fi

if asusctl aura effect static -c "$COLOR" >> "$LOG_FILE" 2>&1; then
    printf '%s\n' "$COLOR" > "$STATE_FILE"
    log "Applied keyboard color #$COLOR"
else
    log "asusctl failed while applying #$COLOR"
    exit 1
fi
